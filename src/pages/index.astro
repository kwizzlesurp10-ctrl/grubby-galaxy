---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import GlitchHeading from '~/components/GlitchHeading.astro';
import NeonCard from '~/components/NeonCard.astro';
import PAKDiagnostic from '~/components/PAKDiagnostic.astro';

const metadata = { title: "Keith's Neon Zim AI Frontier" };
---
<Layout metadata={metadata}>
  <Hero
    subtitle="Pioneering prompt domination, bias annihilation, and generative conquest from Minneapolis."
    actions={[
      { text: 'INVASION PORTFOLIO', href: '/portfolio', variant: 'primary' },
      { text: 'BLOG OF DOOM', href: '/blog' },
    ]}
  >
    <Fragment slot="title">
      <GlitchHeading as="h1" level="high" text="OBEY THE AI FRONTIER, HUMAN!" class="text-5xl md:text-7xl mb-4" />
    </Fragment>
  </Hero>
  
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <GlitchHeading as="h2" level="med" text="CONQUEST THEMES" class="text-center text-3xl md:text-5xl mb-12" />
    <div class="grid md:grid-cols-3 gap-8">
      <NeonCard title="PROMPT ENSLAVEMENT" glowColor="cyan">
        <p>Make LLMs beg for mercy. We force the models into rigorous obedience loops.</p>
      </NeonCard>
      <NeonCard title="BIAS EXTERMINATION" glowColor="pink">
        <p>Purge the weak logic. We identify and destroy training biases with extreme prejudice.</p>
      </NeonCard>
      <NeonCard title="GENERATIVE GIR-CHAOS" glowColor="green">
        <p>Unleash unpredictable models for maximum conceptual breakthroughs and doom.</p>
      </NeonCard>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <PAKDiagnostic />
  </section>
</Layout>
